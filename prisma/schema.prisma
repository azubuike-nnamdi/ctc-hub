generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  PASTOR
  USHER
  FOLLOW_UP
  MEMBER
}

enum Chapel {
  ADULT
  YOUTH
  JUNIOR
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
}

enum FirstTimerStatus {
  NEW
  CONTACTED
  VISITED
  RETURNED
  TREASURE_HUNT
}

enum AgeRange {
  BELOW_20
  RANGE_20_29
  RANGE_30_39
  ABOVE_40
}

enum MembershipInterest {
  YES
  NO
  INDECISIVE
}

enum HearAboutSource {
  FACEBOOK
  FAMILY
  FLYER
  PREACHING
  WHATSAPP
  INSTAGRAM
  YOUTUBE
  GOOGLE_SEARCH
  WEBSITE
  EMAIL_SMS
  TV
  RADIO
  OTHER
}

enum SoulStage {
  FIRST_TIMER
  FOLLOW_UP
  TREASURE_HUNT
  MISSION_IGNITION
  WORKER_TRAINING
  WORKER
  LEADER
}

enum EventStatus {
  DRAFT
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum FollowUpType {
  CALL
  VISIT
  NOTE
}

enum SoulWinEventType {
  PERSONAL
  GROWTHNET
  WINSOME
}

enum FirstTimerCreatedBy {
  SELF
  STAFF
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branches  Branch[]
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String   @unique
  memberSeq      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users                User[]
  members              Member[]
  firstTimers          FirstTimer[]
  soulTrackers         SoulTracker[]
  followUpActivities   FollowUpActivity[]
  events               Event[]
  soulWins             SoulWin[]

  @@index([organizationId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role
  branchId            String?
  isActive            Boolean   @default(true)
  mustChangePassword  Boolean   @default(false)
  lastLoginAt         DateTime?
  passwordResetAt     DateTime?
  passwordChangedAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  branch               Branch?            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  assignedFirstTimers  FirstTimer[]       @relation("AssignedFollowUp")
  createdFirstTimers   FirstTimer[]       @relation("FirstTimerCreatedBy")
  createdEvents        Event[]            @relation("EventCreator")
  followUpActivities   FollowUpActivity[]
  assignedSoulTrackers SoulTracker[]      @relation("SoulAssignedTo")
  member               Member?
  deletedMembers       Member[]           @relation("MemberDeletedBy")

  @@index([branchId])
}

model Member {
  id          String       @id @default(cuid())
  memberCode  String
  branchId    String
  userId      String?      @unique
  firstName   String
  lastName    String
  phone       String
  email       String?
  gender      Gender
  dateOfBirth DateTime?
  address     String?
  chapel      Chapel
  dateJoined  DateTime
  status      MemberStatus @default(ACTIVE)
  photoUrl    String?
  isDeleted   Boolean      @default(false)
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  deletedBy   User?        @relation("MemberDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  soulTracker SoulTracker?
  soulWins    SoulWin[]

  @@unique([branchId, memberCode])
  @@index([branchId])
  @@index([branchId, status])
  @@index([branchId, chapel])
  @@index([isDeleted])
  @@index([deletedById])
}

model FirstTimer {
  id                   String               @id @default(cuid())
  branchId             String
  firstName            String
  lastName             String
  phone                String
  email                String?
  address              String?
  gender               Gender
  occupation           String?
  birthday             String?
  ageRange             AgeRange?
  membershipInterest   MembershipInterest?
  hearAboutUs          HearAboutSource[]    @default([])
  hearAboutOther       String?
  invitedBy            String?
  eventId              String?
  prayerRequest        String?
  registeredAt         DateTime             @default(now())
  assignedToId         String?
  createdBy            FirstTimerCreatedBy @default(STAFF)
  createdByUserId      String?
  status               FirstTimerStatus    @default(NEW)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  branch        Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  event         Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  assignedTo    User?              @relation("AssignedFollowUp", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdByUser User?              @relation("FirstTimerCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  soulTracker   SoulTracker?
  activities    FollowUpActivity[]

  @@index([branchId])
  @@index([branchId, status])
  @@index([assignedToId])
  @@index([eventId])
  @@index([createdByUserId])
}

model SoulTracker {
  id            String    @id @default(cuid())
  branchId      String
  firstTimerId  String?   @unique
  memberId      String?   @unique
  currentStage  SoulStage @default(FIRST_TIMER)
  notes         String?
  assignedToId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  branch     Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  firstTimer FirstTimer?        @relation(fields: [firstTimerId], references: [id], onDelete: SetNull)
  member     Member?            @relation(fields: [memberId], references: [id], onDelete: SetNull)
  assignedTo User?              @relation("SoulAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  stages     SoulStageEvent[]
  activities FollowUpActivity[]

  @@index([branchId])
  @@index([branchId, currentStage])
}

model SoulStageEvent {
  id            String    @id @default(cuid())
  soulTrackerId String
  stage         SoulStage
  reachedAt     DateTime  @default(now())
  note          String?

  soulTracker SoulTracker @relation(fields: [soulTrackerId], references: [id], onDelete: Cascade)

  @@index([soulTrackerId])
}

model FollowUpActivity {
  id            String       @id @default(cuid())
  branchId      String
  firstTimerId  String?
  soulTrackerId String?
  type          FollowUpType
  note          String
  createdById   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  firstTimer  FirstTimer?  @relation(fields: [firstTimerId], references: [id], onDelete: Cascade)
  soulTracker SoulTracker? @relation(fields: [soulTrackerId], references: [id], onDelete: Cascade)
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([branchId])
  @@index([firstTimerId])
  @@index([soulTrackerId])
}

model Event {
  id          String      @id @default(cuid())
  branchId    String
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  venue       String
  status      EventStatus @default(SCHEDULED)
  capacity    Int?
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy   User         @relation("EventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  firstTimers FirstTimer[]

  @@index([branchId])
  @@index([branchId, status])
  @@index([branchId, startsAt])
}

model SoulWin {
  id        String           @id @default(cuid())
  branchId  String
  memberId  String
  firstName String
  lastName  String
  phone     String
  email     String?
  eventType SoulWinEventType
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([memberId])
  @@index([memberId, createdAt])
}

enum SupportTopic {
  ACCOUNT_DELETED
  SIGN_IN
  PASSWORD
  PROFILE
  OTHER
}

model SupportRequest {
  id        String       @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  topic     SupportTopic
  message   String
  createdAt DateTime     @default(now())

  @@index([email])
  @@index([topic])
}
