#!/bin/sh

echo "🔍 Running pre-push hook..."

export CI=true
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" 2>/dev/null
export PATH="$HOME/Library/pnpm:$PATH"

base_branch=""
for candidate in origin/main origin/master main master; do
  if git rev-parse --verify "$candidate" >/dev/null 2>&1; then
    base_branch="$candidate"
    break
  fi
done

if [ -n "$base_branch" ]; then
  files_changed=$(git diff --name-only "$base_branch"...HEAD 2>/dev/null || true)

  if echo "$files_changed" | grep -qE '^(package\.json|pnpm-lock\.yaml)$'; then
    echo "📦 Dependencies changed. Running pnpm install..."
    pnpm install --frozen-lockfile
  fi
fi

echo "🏗️ Running build..."
pnpm build

if [ $? -ne 0 ]; then
  echo "❌ Build failed. Push aborted."
  exit 1
fi

echo "➡️ Running type check..."
pnpm typecheck

if [ $? -ne 0 ]; then
  echo "❌ Type check failed. Push aborted."
  exit 1
fi

echo "✅ Build and checks passed. Proceeding with push..."
